# Copie para .env.local e preencha. Nenhum arquivo de env é versionado.

# Supabase — para o ambiente local, pegue os valores com:
#   pnpm exec supabase status
# (API_URL, PUBLISHABLE_KEY e SECRET_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Brevo (e-mails transacionais)
BREVO_API_KEY=

# Web Push — gerar com `pnpm exec web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protege o endpoint do cron da Vercel
CRON_SECRET=
